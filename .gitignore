# 依赖
node_modules/
cloudfunctions/*/node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# 小程序上传密钥（千万不要提交，泄露等于别人能以你的身份发版本）
private.*.key
*.private.key

# 本地环境变量
.env
.env.*
cloudfunctions/*/env.json

# 开发者工具本地配置（含你的 AppID 与本机路径）
project.private.config.json

# 打包产物
*.zip
*.tar.gz

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
