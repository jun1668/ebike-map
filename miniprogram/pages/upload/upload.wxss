.page {
  padding: 0 24rpx 200rpx;
}

.intro {
  padding: 28rpx 8rpx 20rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 600;
}

.intro-desc {
  font-size: 25rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.block {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 18rpx;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.req {
  color: var(--danger);
  margin-right: 6rpx;
}

.link {
  font-size: 24rpx;
  color: var(--brand);
}

.ph {
  color: var(--text-3);
}

/* 品牌网格 */
.brand-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.brand-item {
  width: calc((100% - 48rpx) / 4);
  height: 108rpx;
  border-radius: 16rpx;
  background: #f5f6f7;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.brand-item.on {
  background: var(--brand-bg);
  border-color: var(--brand);
}

.brand-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.brand-text {
  font-size: 23rpx;
  color: var(--text-2);
}

.brand-item.on .brand-text {
  color: var(--brand);
  font-weight: 500;
}

.custom-row {
  margin-top: 18rpx;
}

.input {
  height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
}

/* 位置 */
.picker-cell {
  display: flex;
  align-items: center;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 27rpx;
}

.cell-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.cell-arrow {
  font-size: 36rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}

.region-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 6rpx 8rpx;
}

.region-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.region-value {
  font-size: 26rpx;
  color: var(--text);
}

.placeholder {
  color: var(--text-3);
}

/* 文本 */
.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 27rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 图片 */
.img-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.img {
  width: 160rpx;
  height: 160rpx;
}

.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  border-bottom-left-radius: 12rpx;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #d6d9de;
  color: var(--text-3);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 进阶 */
.advanced {
  margin-top: 16rpx;
}

.hint {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-bottom: 14rpx;
}

/* 同意 */
.agree {
  padding: 10rpx 8rpx 0;
}

.agree-label {
  display: flex;
  align-items: flex-start;
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* 提交 */
.submit-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

/* 备注里识别到链接时的提示 */
.link-hint {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  background: var(--brand-bg);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.5;
}

.link-hint.warn {
  background: #fff6e6;
  color: #a8621a;
}

/* ===== 快速上传卡片 ===== */
.quick-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: linear-gradient(135deg, #0f766e, #12a596);
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
  color: #fff;
}

.quick-main {
  flex: 1;
  min-width: 0;
}

.quick-title {
  font-size: 29rpx;
  font-weight: 700;
}

.quick-desc {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 8rpx;
  line-height: 1.55;
}

.quick-btn {
  flex: 0 0 auto;
  background: #fff;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 26rpx;
  border-radius: 40rpx;
}

.quick-btn:active {
  opacity: 0.8;
}

.quick-card.done {
  background: #e6f4f1;
}

.quick-card.done .quick-title {
  color: #0f766e;
}

.quick-card.done .quick-desc {
  color: #3f5f5b;
  opacity: 1;
}
