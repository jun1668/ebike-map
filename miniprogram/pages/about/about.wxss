.page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
}

.head {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
}

.logo {
  font-size: 96rpx;
  line-height: 1.2;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.head-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

.block {
  margin-bottom: 20rpx;
}

.h {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.p {
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.75;
  margin-bottom: 10rpx;
}

.p.dim {
  color: var(--text-3);
}

.feedback-btn {
  margin-top: 10rpx;
  background: var(--brand-bg);
  color: var(--brand);
  font-size: 27rpx;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.feedback-btn::after {
  border: none;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 30rpx;
}

.agree-link {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #0f766e;
  font-weight: 500;
}
