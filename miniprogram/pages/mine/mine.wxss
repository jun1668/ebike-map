.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.stats {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  padding: 44rpx 0;
  color: #fff;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  font-size: 23rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.28);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.section-more {
  font-size: 24rpx;
  color: var(--brand);
}

.item {
  margin: 0 24rpx 16rpx;
  display: flex;
  align-items: center;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name {
  font-size: 29rpx;
  font-weight: 500;
}

.item-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.item-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
}

.mini-btn {
  font-size: 22rpx;
  line-height: 52rpx;
  height: 52rpx;
  padding: 0 22rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #f2f3f5;
  color: var(--text-2);
}

.mini-btn::after {
  border: none;
}

.mini-btn.danger {
  color: var(--danger);
  background: #fdecec;
}

.empty-block {
  padding: 70rpx 40rpx 30rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

.empty-btn {
  margin: 34rpx auto 0;
  width: 320rpx;
}

.menu {
  margin: 30rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 26rpx;
  font-size: 27rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-btn {
  width: 100%;
  background: transparent;
  border-radius: 0;
  text-align: left;
  line-height: 1.4;
  margin: 0;
}

.menu-btn::after {
  border: none;
}

.cell-arrow {
  color: var(--text-3);
  font-size: 32rpx;
}

/* 上传 / 收藏 分段器 */
.mine-seg {
  display: flex;
  margin: 8rpx 0 4rpx;
  background: #eef0f3;
  border-radius: 16rpx;
  padding: 6rpx;
}
.mine-seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: #6b7480;
  border-radius: 12rpx;
}
.mine-seg-item.on {
  background: #fff;
  color: #0f766e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .06);
}
.item-dead { opacity: .6; }
