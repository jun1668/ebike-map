.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ---------- 顶部工具区 ---------- */
.toolbar {
  background: #fff;
  padding: 16rpx 24rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.loc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 4rpx 14rpx;
}

.loc-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.loc-dot {
  color: var(--text-3);
  font-size: 30rpx;
  margin-right: 8rpx;
}

.loc-dot.on {
  color: var(--brand);
}

.loc-text {
  font-size: 28rpx;
  color: var(--text);
  max-width: 460rpx;
}

.loc-action {
  font-size: 24rpx;
  color: var(--brand);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 0 20rpx;
  min-width: 0;
}

.search-ico {
  color: var(--text-3);
  font-size: 32rpx;
  margin-right: 8rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  min-width: 0;
}

.ph {
  color: var(--text-3);
}

.search-clear {
  color: var(--text-3);
  font-size: 34rpx;
  padding: 0 6rpx;
}

.filter-chip {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.filter-chip.active {
  background: var(--brand-bg);
  color: var(--brand);
}

.caret {
  font-size: 20rpx;
  opacity: 0.7;
}

.brand-scroll {
  white-space: nowrap;
  padding: 16rpx 0 12rpx;
}

.brand-chip {
  display: inline-block;
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #f5f6f7;
  color: var(--text-2);
  font-size: 25rpx;
  margin-right: 14rpx;
}

.brand-chip.active {
  background: var(--brand);
  color: #fff;
}

/* ---------- 切换 ---------- */
.seg {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx 10rpx;
}

.seg-group {
  display: flex;
  background: #e9ebee;
  border-radius: 12rpx;
  padding: 4rpx;
}

.seg-item {
  padding: 8rpx 30rpx;
  font-size: 25rpx;
  color: var(--text-2);
  border-radius: 9rpx;
}

.seg-item.on {
  background: #fff;
  color: var(--text);
  font-weight: 500;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.seg-count {
  font-size: 23rpx;
  color: var(--text-3);
}

/* ---------- 列表 ---------- */
.list {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
}

.spot-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.spot-head {
  display: flex;
  align-items: center;
}

.brand-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.spot-main {
  flex: 1;
  min-width: 0;
}

.spot-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.spot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  max-width: 360rpx;
}

.spot-dist {
  font-size: 23rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.spot-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.spot-remark {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 14rpx;
  line-height: 1.5;
}

.spot-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.spot-time {
  font-size: 22rpx;
  color: var(--text-3);
}

.list-end {
  text-align: center;
  font-size: 23rpx;
  color: var(--text-3);
  padding: 20rpx 0 40rpx;
}

/* ---------- 空状态 ---------- */
.empty-block {
  padding: 90rpx 40rpx 60rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 90rpx;
  line-height: 1.2;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 380rpx;
}

/* ---------- 地图 ---------- */
.map-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.map-actions {
  position: absolute;
  right: 24rpx;
  bottom: 220rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.map-fab {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--brand);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.map-tip {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 24rpx;
  background: rgba(0, 0, 0, 0.62);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  text-align: center;
}

.sheet {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
}

.sheet-head {
  display: flex;
  align-items: center;
}

.sheet-close {
  font-size: 40rpx;
  color: var(--text-3);
  padding: 0 8rpx;
  line-height: 1;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
}

.sheet-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  margin: 0;
}

/* 更多操作（任何人都能维护这条信息） */
.more-btn {
  width: 56rpx;
  height: 56rpx;
  margin: -12rpx -12rpx -12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9099a5;
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
}
